# Local development example. Replace placeholders locally; never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
PRODUCTION=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=UTC

# PostgreSQL: use DATABASE_URL OR all DB_* values below.
# Coolify internal service URL example:
# DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_SERVICE_HOST:5432/DATABASE
DATABASE_URL=
# DB_NAME=database_name
# DB_USER=database_user
# DB_PASSWORD=database_password
# DB_HOST=postgres-service-hostname
# DB_PORT=5432
DATABASE_SSL_REQUIRE=False

# Cloudinary: use CLOUDINARY_URL OR set all three CLOUDINARY_* values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Martin Boxabl <martin@martinboxabl.com>
SUPPORT_EMAIL=support@martinboxabl.com
ORDER_EMAIL=orders@martinboxabl.com
SITE_NAME=Martin Boxabl
WAGTAILADMIN_BASE_URL=http://localhost:8000
