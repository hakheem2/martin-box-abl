# Required in production. Generate a private random value and store it in Coolify.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
PRODUCTION=True
ALLOWED_HOSTS=martinboxabl.com,www.martinboxabl.com
CSRF_TRUSTED_ORIGINS=https://martinboxabl.com,https://www.martinboxabl.com
SECURE_SSL_REDIRECT=True
TIME_ZONE=UTC

# Coolify PostgreSQL connection URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Cloudinary. Either provide CLOUDINARY_URL or the three separate credentials.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend API. Use a sender address verified in your Resend account.
RESEND_API_KEY=re_replace_with_your_resend_api_key
DEFAULT_FROM_EMAIL=Martin Boxabl <martin@martinboxabl.com>
CONTACT_EMAIL=support@martinboxabl.com
SUPPORT_EMAIL=support@martinboxabl.com
ORDER_EMAIL=orders@martinboxabl.com

SITE_NAME=Martin Boxabl
WAGTAILADMIN_BASE_URL=https://martinboxabl.com
